@model IEnumerable<Mutiview_BaseballPark.Models.Stadium>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">台灣棒球場多視角圖</h1>
  
    <div class="row mt-4">
        <div class="col-12">
            <h2>球場列表</h2>
            <div class="list-group">
                @if (Model != null)
                {
                    @foreach (var stadium in Model)
                    {
                        <div class="list-group-item">
                            <h5 class="mb-1">@stadium.StadiumName</h5>
                            <p class="mb-1">@stadium.City, @stadium.Country</p>
                            <div class="mt-2">
                                <a href="@Url.Action("ViewImages", "Home", new { stadiumId = stadium.StadiumId })"
                                   class="btn btn-outline-primary btn-sm">
                                    查看座位視角圖片
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>沒有找到球場資料。</p>
                }
            </div>
        </div>
    </div>
</div>
