@model IEnumerable<Mutiview_BaseballPark.Models.StadiumViewModel>

@{
    ViewData["Title"] = "台灣棒球場多視角圖";
}

<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
  
    <div class="row mt-4">
        <div class="col-12">
            <h2>球場列表</h2>
            <div class="list-group">
                @if (Model != null)
                {
                    @foreach (var stadiumViewModel in Model)
                    {
                        <div class="list-group-item">
                            <div class="row">
                                <div class="col-md-4">
                                    @if (!string.IsNullOrEmpty(stadiumViewModel.MainImageUrl))
                                    {
                                        <img src="@stadiumViewModel.MainImageUrl" class="img-fluid rounded" alt="@stadiumViewModel.StadiumName 正面圖">
                                    }
                                    else
                                    {
                                        <div class="text-muted">無正面圖</div>
                                    }
                                </div>
                                <div class="col-md-8">
                                    <h5 class="mb-1">@stadiumViewModel.StadiumName</h5>
                                    <p class="mb-1">@stadiumViewModel.City, @stadiumViewModel.Country</p>
                                    <div class="mt-2">
                                        <a href="@Url.Action("ViewImages", "Home", new { stadiumId = stadiumViewModel.StadiumId })"
                                           class="btn btn-outline-primary btn-sm">
                                            查看座位視角圖片
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>沒有找到球場資料。</p>
                }
            </div>
        </div>
    </div>
</div>
