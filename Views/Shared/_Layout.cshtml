<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mutiview_BaseballPark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mutiview_BaseballPark.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .full-width-banner {
            width: 100%;
            height: 200px; /* 您可以根據需要調整高度 */
            /* background-color: #f8f9fa; */ /* 移除或註解此行 */
            background-image: url('/images/baseball-field-banner.png'); /* 設定背景圖片 */
            background-size: cover; /* 讓圖片覆蓋整個 banner 區域 */
            background-position: center; /* 圖片置中 */
            background-repeat: no-repeat; /* 不重複圖片 */
            color: #ffffff; /* 文字顏色，根據圖片調整以確保可讀性 */
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-size: 2em;
            font-weight: bold;
            margin-bottom: 20px; /* 與下方內容的間距 */
        }
    </style>
</head>
<body>
    @* Full-width Banner *@
    <div class="full-width-banner">
        歡迎來到台灣棒球場視角圖
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Mutiview_BaseballPark - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
